   "source": [
    "SELECT COUNT(*) AS nb_heures_risque_neige\n",
    "FROM workspace.meteo.bronze_weather\n",
    "WHERE CAST(heure AS TIMESTAMP) BETWEEN current_timestamp()\n",
    "                                   AND current_timestamp() + INTERVAL 24 HOURS\n",
    "  AND temperature <= 1\n",
    "  AND precipitation > 0"
   ]
