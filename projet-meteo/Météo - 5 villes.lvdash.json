{
  "datasets": [
    {
      "name": "a7502c17",
      "displayName": "meteo_jour",
      "queryLines": [
        "SELECT ville, jour, temp_min, temp_max, temp_moy, pluie_totale, nb_mesures\r\n",
        "FROM workspace.meteo.gold_daily_weather\r\n"
      ]
    },
    {
      "name": "7143fc3e",
      "displayName": "meteo_tendance",
      "queryLines": [
        "SELECT\r\n",
        "    ville, jour, temp_moy,\r\n",
        "    ROUND(AVG(temp_moy) OVER (PARTITION BY ville ORDER BY jour\r\n",
        "          ROWS BETWEEN 6 PRECEDING AND CURRENT ROW), 1) AS temp_moy_7j,\r\n",
        "    ROUND(temp_moy - LAG(temp_moy) OVER (PARTITION BY ville ORDER BY jour), 1) AS variation_veille\r\n",
        "FROM workspace.meteo.gold_daily_weather"
      ]
    },
    {
      "name": "2820e0f0",
      "displayName": "meteo_classement",
      "queryLines": [
        "SELECT\r\n",
        "    ville,\r\n",
        "    ROUND(AVG(temp_moy), 1) AS temp_moy_periode,\r\n",
        "    ROUND(SUM(pluie_totale), 1) AS pluie_periode,\r\n",
        "    RANK() OVER (ORDER BY AVG(temp_moy) DESC) AS rang_chaleur,\r\n",
        "    RANK() OVER (ORDER BY SUM(pluie_totale) DESC) AS rang_pluie\r\n",
        "FROM workspace.meteo.gold_daily_weather\r\n",
        "GROUP BY ville"
      ]
    },
    {
      "name": "a88a42ed",
      "displayName": "meteo_series_pluie",
      "queryLines": [
        "WITH j AS (\r\n",
        "    SELECT ville, jour, pluie_totale >= 1 AS pluie\r\n",
        "    FROM workspace.meteo.gold_daily_weather\r\n",
        "),\r\n",
        "g AS (\r\n",
        "    SELECT *,\r\n",
        "           ROW_NUMBER() OVER (PARTITION BY ville ORDER BY jour)\r\n",
        "         - ROW_NUMBER() OVER (PARTITION BY ville, pluie ORDER BY jour) AS grp\r\n",
        "    FROM j\r\n",
        ")\r\n",
        "SELECT ville, MIN(jour) AS debut, MAX(jour) AS fin, COUNT(*) AS nb_jours\r\n",
        "FROM g\r\n",
        "WHERE pluie\r\n",
        "GROUP BY ville, grp\r\n",
        "ORDER BY nb_jours DESC"
      ]
    },
    {
      "name": "fe2a4ec5",
      "displayName": "meteo_records",
      "queryLines": [
        "SELECT 'Jour le plus chaud' AS record, ville, jour, temp_max AS valeur\r\n",
        "FROM (SELECT * FROM workspace.meteo.gold_daily_weather ORDER BY temp_max DESC LIMIT 1)\r\n",
        "UNION ALL\r\n",
        "SELECT 'Jour le plus froid', ville, jour, temp_min\r\n",
        "FROM (SELECT * FROM workspace.meteo.gold_daily_weather ORDER BY temp_min ASC LIMIT 1)\r\n",
        "UNION ALL\r\n",
        "SELECT 'Jour le plus pluvieux', ville, jour, pluie_totale\r\n",
        "FROM (SELECT * FROM workspace.meteo.gold_daily_weather ORDER BY pluie_totale DESC LIMIT 1)"
      ]
    }
  ],
